# Orkestr Travel — environment template.
#
# NAMES AND SAFE PLACEHOLDERS ONLY. Never commit a real value.
# Rules (see docs/SECURITY.md):
#   * A secret must NEVER use the NEXT_PUBLIC_ prefix — that prefix inlines the
#     value into the browser bundle at build time.
#   * Every integration defaults to OFF. Nothing here is required to run the
#     deterministic core or the test suite.
#
# Status at Phase 0: no integration is implemented. These names are declared so
# that the security boundary is defined before any credential exists.

# ---------------------------------------------------------------------------
# Alibaba Cloud Model Studio (Qwen) — PHASE 6, not yet implemented
# ---------------------------------------------------------------------------
# Enables structured extraction and web research. Off until founder approval.
ORKESTR_ENABLE_QWEN=false
# Server-side only. Never expose to the browser.
DASHSCOPE_API_KEY=
# Model Studio endpoint region base URL, e.g. an intl or cn endpoint.
DASHSCOPE_BASE_URL=
QWEN_MODEL=

# ---------------------------------------------------------------------------
# Atlas flight provider — PHASE 7, not yet implemented
# ---------------------------------------------------------------------------
# SANDBOX ONLY during development. A production value must never be set here.
ORKESTR_FLIGHT_PROVIDER=mock
ATLAS_ENVIRONMENT=sandbox
ATLAS_API_KEY=
ATLAS_API_BASE_URL=

# ---------------------------------------------------------------------------
# Web research provider — PHASE 6, not yet implemented
# ---------------------------------------------------------------------------
ORKESTR_ENABLE_WEB_RESEARCH=false

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Marks every provider-sourced record in the UI as sandbox data.
ORKESTR_SANDBOX_LABEL=true
