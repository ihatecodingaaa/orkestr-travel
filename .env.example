# Orkestr Travel — environment template.
#
# NAMES AND SAFE PLACEHOLDERS ONLY. Never commit a real value.
# Copy to `.env.local`, which is gitignored, and fill it in there.
#
# Rules (see docs/SECURITY.md):
#   * A secret must NEVER use the NEXT_PUBLIC_ prefix — that prefix inlines the
#     value into the browser bundle at build time.
#   * Every integration is OPTIONAL. Nothing here is required to run the
#     deterministic core, the test suite, the production build, or the demo.
#     With this file empty the application runs in fixture mode and says so.

# ---------------------------------------------------------------------------
# Alibaba Cloud Model Studio (Qwen) — PHASE 6, implemented
# ---------------------------------------------------------------------------
# Powers structured intent extraction and bounded web research.
#
# With no key set, the application does NOT break: the understanding screen
# replays a recorded demo reading and labels it as one, and the research screen
# replays a recorded structured result and labels it RECORDED, never LIVE.

# Server-side only. Never exposed to the browser; read in exactly one module
# (src/adapters/modelStudio/config.ts) and used in exactly one place, the
# Authorization header in src/adapters/modelStudio/transport.ts.
DASHSCOPE_API_KEY=

# Your Model Studio workspace id, from the Workspace Details page in the
# console. It is account configuration, so it lives here and never in the repo.
MODEL_STUDIO_WORKSPACE_ID=

# Region for the OpenAI-compatible endpoint. Singapore is the default.
# Known values: ap-southeast-1, ap-northeast-1, cn-beijing, cn-hongkong,
# eu-central-1.
MODEL_STUDIO_REGION=ap-southeast-1

# Optional. Overrides the region + workspace endpoint entirely. Must be https.
# Useful if the endpoint host changes, or for a legacy shared domain.
DASHSCOPE_BASE_URL=

# Models. Environment-configurable on purpose: nothing is architected around
# one model name, and a more expensive model is never selected automatically.
QWEN_EXTRACTION_MODEL=qwen3.7-plus
QWEN_RESEARCH_MODEL=qwen3.7-plus

# How structured output is requested: json_object (default) or json_schema.
# Model Studio documents json_object for every Qwen model that supports
# structured output; its json_schema documentation is inconsistent between
# pages, so the unambiguous mode is the default. Either way the response is
# validated by src/core/intent/schema.ts, which is the real guarantee.
QWEN_STRUCTURED_OUTPUT_MODE=json_object

# Per-call deadline in milliseconds. 1–120000. Defaults to 30000.
MODEL_STUDIO_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Atlas flight provider — PHASE 7, not yet implemented
# ---------------------------------------------------------------------------
# SANDBOX ONLY during development. A production value must never be set here.
ORKESTR_FLIGHT_PROVIDER=mock
ATLAS_ENVIRONMENT=sandbox
ATLAS_API_KEY=
ATLAS_API_BASE_URL=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Marks every provider-sourced record in the UI as sandbox data.
ORKESTR_SANDBOX_LABEL=true
