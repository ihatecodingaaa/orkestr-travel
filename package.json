{
  "name": "orkestr-travel",
  "version": "0.0.0",
  "private": true,
  "description": "Orkestr Travel - a coordination agent that turns the changing needs of multiple travellers into one feasible, evidence-backed group journey.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run check && npm run build && npm run test:bundle",
    "smoke:model-studio": "vitest run --config vitest.live.config.ts evals/smoke.live.ts",
    "connectivity:model-studio": "vitest run --config vitest.live.config.ts evals/connectivity.live.ts",
    "timing:understand": "vitest run --config vitest.live.config.ts evals/understandPayload.live.ts",
    "eval:qwen": "vitest run --config vitest.live.config.ts evals/extraction.live.ts",
    "preflight:model-studio": "node scripts/preflight.mjs",
    "check:secrets": "node scripts/checkSecrets.mjs",
    "adversarial:qwen": "vitest run --config vitest.live.config.ts evals/adversarial.live.ts",
    "smoke:responses": "vitest run --config vitest.live.config.ts evals/responsesSmoke.live.ts",
    "research:live": "vitest run --config vitest.live.config.ts evals/research.live.ts",
    "research:diagnose": "vitest run --config vitest.live.config.ts evals/researchDiagnostic.live.ts",
    "shared:live": "vitest run --config vitest.live.config.ts evals/sharedLinks.live.ts",
    "atlas:smoke": "vitest run --config vitest.live.config.ts evals/atlas.live.ts",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "db:migrate": "node -e \"import('./scripts/loadEnv.mjs').then(m=>{m.loadEnvLocal();import('./scripts/migrate.mjs')})\"",
    "db:status": "node -e \"import('./scripts/loadEnv.mjs').then(m=>{m.loadEnvLocal();process.argv.push('--status');import('./scripts/migrate.mjs')})\"",
    "db:check": "node scripts/dbCheck.mjs",
    "db:cleanup": "node scripts/cleanupSynthetic.mjs",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  }
}
